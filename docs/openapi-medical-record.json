{
  "openapi": "3.1.0",
  "info": {
    "title": "Medical Record Service",
    "description": "Serviço de gerenciamento de prontuários médicos",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/pacientes/{paciente_id}/registros": {
      "post": {
        "tags": [
          "Prontuário"
        ],
        "summary": "Adiciona um registro ao prontuário do paciente",
        "operationId": "adicionar_registro_v1_pacientes__paciente_id__registros_post",
        "parameters": [
          {
            "name": "paciente_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Paciente Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registro adicionado ao prontuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistroResponse"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos (ex.: descrição vazia, tipo desconhecido ou id malformado)"
          }
        }
      },
      "get": {
        "tags": [
          "Prontuário"
        ],
        "summary": "Consulta o prontuário do paciente",
        "operationId": "consultar_prontuario_v1_pacientes__paciente_id__registros_get",
        "parameters": [
          {
            "name": "paciente_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Paciente Id"
            }
          },
          {
            "name": "tipo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TipoRegistro"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtra por tipo de registro",
              "title": "Tipo"
            },
            "description": "Filtra por tipo de registro"
          }
        ],
        "responses": {
          "200": {
            "description": "Registros do paciente (lista vazia se não houver nenhum)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RegistroResponse"
                  },
                  "title": "Response Consultar Prontuario V1 Pacientes  Paciente Id  Registros Get"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos (ex.: descrição vazia, tipo desconhecido ou id malformado)"
          }
        }
      }
    },
    "/v1/pacientes/{paciente_id}/registros/{registro_id}": {
      "get": {
        "tags": [
          "Prontuário"
        ],
        "summary": "Consulta um registro específico do prontuário",
        "operationId": "obter_registro_v1_pacientes__paciente_id__registros__registro_id__get",
        "parameters": [
          {
            "name": "paciente_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Paciente Id"
            }
          },
          {
            "name": "registro_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Registro Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registro encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistroResponse"
                }
              }
            }
          },
          "404": {
            "description": "Registro não encontrado (ou pertence a outro paciente)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos (ex.: descrição vazia, tipo desconhecido ou id malformado)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErroResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "examples": [
              "Registro não encontrado"
            ]
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErroResponse",
        "description": "Formato das respostas de erro de negócio (404)."
      },
      "RegistroCreate": {
        "properties": {
          "profissional_id": {
            "type": "string",
            "title": "Profissional Id",
            "examples": [
              "medico-001"
            ]
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoRegistro",
            "examples": [
              "exame"
            ]
          },
          "descricao": {
            "type": "string",
            "maxLength": 2000,
            "title": "Descricao",
            "description": "Texto do registro. Espaços nas pontas são removidos; não pode ser vazio.",
            "examples": [
              "Hemograma completo sem alterações"
            ]
          },
          "consulta_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consulta Id",
            "description": "Id da consulta (scheduling) à qual o registro se refere. Apenas armazenado, não validado.",
            "examples": [
              "3fa85f64-5717-4562-b3fc-2c963f66afa6"
            ]
          }
        },
        "type": "object",
        "required": [
          "profissional_id",
          "tipo",
          "descricao"
        ],
        "title": "RegistroCreate"
      },
      "RegistroResponse": {
        "properties": {
          "profissional_id": {
            "type": "string",
            "title": "Profissional Id",
            "examples": [
              "medico-001"
            ]
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoRegistro",
            "examples": [
              "exame"
            ]
          },
          "descricao": {
            "type": "string",
            "maxLength": 2000,
            "title": "Descricao",
            "description": "Texto do registro. Espaços nas pontas são removidos; não pode ser vazio.",
            "examples": [
              "Hemograma completo sem alterações"
            ]
          },
          "consulta_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consulta Id",
            "description": "Id da consulta (scheduling) à qual o registro se refere. Apenas armazenado, não validado.",
            "examples": [
              "3fa85f64-5717-4562-b3fc-2c963f66afa6"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "examples": [
              "9b2f6d1e-4c3a-4f5b-8a7d-1e2f3a4b5c6d"
            ]
          },
          "paciente_id": {
            "type": "string",
            "title": "Paciente Id",
            "examples": [
              "paciente-001"
            ]
          },
          "criado_em": {
            "type": "string",
            "format": "date-time",
            "title": "Criado Em",
            "examples": [
              "2026-11-15T21:34:00Z"
            ]
          }
        },
        "type": "object",
        "required": [
          "profissional_id",
          "tipo",
          "descricao",
          "id",
          "paciente_id",
          "criado_em"
        ],
        "title": "RegistroResponse"
      },
      "TipoRegistro": {
        "type": "string",
        "enum": [
          "anotacao",
          "exame",
          "prescricao"
        ],
        "title": "TipoRegistro"
      }
    }
  }
}